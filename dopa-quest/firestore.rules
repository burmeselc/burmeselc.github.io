rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/dopa_snapshots/{docid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      allow get, list: if isOwner();
      allow create, update: if isOwner() && (
        (docid == 'meta' &&
         request.resource.data.keys().hasOnly(['rev','chunks','format','updatedAt']) &&
         request.resource.data.rev is int && request.resource.data.rev > 0 &&
         request.resource.data.chunks is int && request.resource.data.chunks > 0 &&
         request.resource.data.chunks <= 300 && request.resource.data.format == 1)
        ||
        (docid.matches('chunk-[0-9]{3}') &&
         request.resource.data.keys().hasOnly(['payload']) &&
         request.resource.data.payload is string &&
         request.resource.data.payload.size() <= 132000)
      );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}